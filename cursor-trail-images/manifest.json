{
  "manifest_version": 3,
  "name": "Cursor Trail (Images)",
  "version": "1.1",
  "description": "Adds a trail of images or emoji that follows your mouse cursor on web pages.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["trail.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
